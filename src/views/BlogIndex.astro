---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaContact from '../components/CtaContact.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema } from '../lib/schema';
import { getPosts, getServices, readingMinutes } from '../i18n/content';
import { localeFromUrl, localeMeta, pageAlternates, pagePath } from '../i18n/locales';
import { useT } from '../i18n/ui';
import heroImg from '../assets/ordinacija/rad-sa-lupama.jpg';

const locale = localeFromUrl(Astro.url);
const t = useT(locale);
const services = await getServices(locale);
const posts = (await getPosts(locale)).map((p) => ({
  ...p,
  category: services.find((s) => s.key === p.data.related[0])?.data.menuTitle,
  minutes: readingMinutes(p.body),
}));
const [featured, ...rest] = posts;

const crumbs = [
  { name: t.nav.home, path: pagePath(locale, 'home') },
  { name: t.nav.blog, path: pagePath(locale, 'blog') },
];
const dateFmt = new Intl.DateTimeFormat(localeMeta[locale].dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={t.meta.blogTitle} description={t.meta.blogDescription} schema={[breadcrumbSchema(crumbs)]} pageType="CollectionPage" alternates={pageAlternates('blog')}>
  <PageHero
    crumbs={crumbs}
    eyebrow={t.blog.eyebrow}
    title={t.blog.title}
    highlight={t.blog.highlight}
    lead={t.blog.lead}
    image={heroImg}
    imageAlt={t.blog.heroAlt}
    trust
  />

  <section class="section-pad bg-tint-2">
    <div class="container-site">
      <!-- Featured -->
      <article class="group relative mb-8 grid overflow-hidden rounded-[var(--radius-card)] border border-card bg-white shadow-[0_16px_40px_rgb(0_0_0/0.06)] lg:grid-cols-2">
        <div class="overflow-hidden">
          <Image
            src={featured.data.image}
            alt=""
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="aspect-[16/10] h-full w-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:group-hover:scale-100 lg:aspect-auto"
          />
        </div>
        <div class="flex flex-col justify-center gap-4 p-7 sm:p-10">
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
            <span class="rounded-full bg-brand-700 px-3 py-1 text-white">{t.common.newest}</span>
            {featured.category && <span class="rounded-full bg-tint-2 px-3 py-1 text-brand-800">{featured.category}</span>}
            <span class="flex items-center gap-1.5"><Icon name="clock" class="h-3.5 w-3.5 text-brand-700" />{t.common.minRead(featured.minutes)}</span>
          </div>
          <h2 class="text-[clamp(1.6rem,1.1rem+1.8vw,2.25rem)] leading-tight">
            <a href={featured.url} class="after:absolute after:inset-0 group-hover:text-brand-700">{featured.data.title}</a>
          </h2>
          <p class="text-lg leading-relaxed">{featured.data.description}</p>
          <span class="mt-2 flex items-center gap-2 font-semibold text-brand-700" aria-hidden="true">
            {t.common.readArticle} <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
          </span>
        </div>
      </article>

      <!-- The rest: two per row on phones, three on large screens -->
      <ul class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3 lg:gap-6">
        {
          rest.map((p) => (
            <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-card bg-white transition hover:-translate-y-1 hover:shadow-[0_16px_40px_rgb(0_0_0/0.1)] motion-reduce:hover:translate-y-0 sm:rounded-[var(--radius-card)]">
              <div class="relative overflow-hidden">
                <Image src={p.data.image} alt="" widths={[240, 400, 560]} sizes="(min-width: 1024px) 360px, 50vw" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:group-hover:scale-100" />
                {p.category && (
                  <span class="absolute top-2.5 left-2.5 rounded-full bg-white/95 px-2.5 py-1 text-[11px] font-bold text-brand-800 shadow-sm sm:top-4 sm:left-4 sm:px-3 sm:text-xs">
                    {p.category}
                  </span>
                )}
              </div>
              <div class="flex flex-1 flex-col gap-2 p-3.5 sm:gap-3 sm:p-6">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold sm:text-xs">
                  <span class="flex items-center gap-1.5"><Icon name="clock" class="h-3.5 w-3.5 text-brand-700" />{t.common.min(p.minutes)}</span>
                  <time class="hidden sm:inline" datetime={p.data.date.toISOString()}>{dateFmt.format(p.data.date)}</time>
                </p>
                <h2 class="text-[15px] leading-snug sm:text-lg">
                  <a href={p.url} class="after:absolute after:inset-0 group-hover:text-brand-700">{p.data.title}</a>
                </h2>
                <p class="hidden text-sm leading-relaxed sm:line-clamp-3">{p.data.description}</p>
                <span class="mt-auto flex items-center gap-1.5 pt-1 text-xs font-semibold text-brand-700 sm:text-sm" aria-hidden="true">
                  {t.common.readMore} <Icon name="arrow-right" class="h-4 w-4" />
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaContact />
</Base>
