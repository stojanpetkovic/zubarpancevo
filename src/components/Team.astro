---
/*
 * The practice team (three people), used on the homepage and on /o-nama/. The people are in
 * config/team.ts, which the Person structured data on /o-nama/ also reads.
 */
import { Image } from 'astro:assets';
import { site, bookingHref } from '../config/site';
import { localeFromUrl, pagePath } from '../i18n/locales';
import { useT } from '../i18n/ui';
import Icon, { type IconName } from './Icon.astro';
import Stars from './Stars.astro';
import { getTeam } from '../config/team';

interface Props {
  /** Show the "Više o nama" link (homepage) or not (the about page itself). */
  aboutLink?: boolean;
}
const { aboutLink = true } = Astro.props;
const locale = localeFromUrl(Astro.url);
const t = useT(locale);
const team = getTeam(locale);
---

<section class="section-pad">
  <div class="container-site flex flex-col gap-12">
    <!-- Intro: heading on the left, rating and actions on the right -->
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-14">
      <div>
        <p class="eyebrow">{t.team.eyebrow}</p>
        <h2 class="mt-4 text-[clamp(1.75rem,1.1rem+2.6vw,2.5rem)] leading-tight">
          {t.team.titleA}<span class="text-brand-700">{t.team.titleB}</span>
        </h2>
        <p class="mt-5 max-w-2xl text-[clamp(1rem,0.9rem+0.4vw,1.125rem)] leading-[1.7]">
          {t.team.lead}
        </p>
      </div>
      <div class="flex flex-col gap-6 lg:items-end">
        <a href={site.rating.url} rel="noopener" target="_blank" class="card flex w-fit items-center gap-4 rounded-2xl px-5! py-4!">
          <span class="font-display text-3xl font-bold text-title">{site.rating.value}</span>
          <span>
            <Stars class="h-4 w-4" />
            <span class="block text-sm">{t.common.patientRatings(site.rating.count)}</span>
          </span>
        </a>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href={bookingHref(locale)} class="btn-primary"><Icon name="calendar" class="h-5 w-5" /> {t.common.book}</a>
          {aboutLink && <a href={pagePath(locale, 'about')} class="btn-outline">{t.common.aboutUs}</a>}
        </div>
      </div>
    </div>

    <!-- People -->
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((m) => (
          <li class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-card bg-white shadow-[0_16px_40px_rgb(0_0_0/0.08)] sm:max-lg:last:odd:col-span-2 sm:max-lg:last:odd:mx-auto sm:max-lg:last:odd:w-[calc(50%-0.75rem)]">
            <div class="relative isolate overflow-hidden">
              <Image
                src={m.img}
                alt={m.alt}
                widths={[400, 600, 800]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                class="h-[22rem] w-full object-cover object-top transition duration-500 group-hover:scale-[1.03] motion-reduce:group-hover:scale-100 sm:h-[26rem]"
              />
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-brand-900/70 to-transparent" aria-hidden="true" />
              <span class="absolute bottom-5 left-5 inline-flex items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-brand-800 shadow-md backdrop-blur">
                <Icon name={m.icon as IconName} class="h-4 w-4" />
                {m.role}
              </span>
            </div>
            <div class="flex flex-1 flex-col gap-4 p-6 sm:p-7">
              <h3 class="text-2xl">{m.name}</h3>
              <p class="flex-1 leading-relaxed">{m.bio}</p>
              <ul class="flex flex-wrap gap-2 border-t border-card pt-5">
                {m.tags.map((tag) => (
                  <li class="rounded-full bg-tint-2 px-3 py-1.5 text-xs font-semibold text-brand-800">{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
