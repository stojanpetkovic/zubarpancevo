---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site';
import { dentistSchema, personSchema, webPageSchema, websiteSchema, type PageType } from '../lib/schema';
import { getServices } from '../i18n/content';
import { useT } from '../i18n/ui';
import { getTeam } from '../config/team';
import { defaultLocale, localeMeta, localeFromUrl, pagePath, type Alternates } from '../i18n/locales';
import ogDefault from '../assets/ordinacija/ordinacija-pancevo.jpg';

interface Props {
  title: string;
  description: string;
  /** Social preview image; the practice interior when not given. */
  image?: ImageMetadata;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Page-specific schema.org nodes, merged into one @graph with the practice. */
  schema?: Record<string, unknown>[];
  /** This page in each language, for hreflang links. */
  alternates?: Alternates;
  /** schema.org type of the page itself; services and posts are MedicalWebPage. */
  pageType?: PageType;
  /** Dates and section for blog posts (article:* Open Graph tags). */
  article?: { published: Date; modified?: Date; section?: string };
}

const {
  title,
  description,
  image = ogDefault,
  type = 'website',
  noindex = false,
  schema = [],
  alternates = {},
  pageType = 'WebPage',
  article,
} = Astro.props;
const locale = localeFromUrl(Astro.url);
const t = useT(locale);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const practicePhoto = await getImage({ src: ogDefault, width: 1200, format: 'jpg' });

const alternateLinks = Object.entries(alternates).filter(([, path]) => path) as [keyof typeof localeMeta, string][];
const xDefault = alternates[defaultLocale];

const staff = await Promise.all(
  getTeam(locale).map(async (m) => ({
    id: m.id,
    name: m.plainName,
    honorificPrefix: m.honorificPrefix,
    jobTitle: m.role,
    url: new URL(pagePath(locale, 'about'), Astro.site).href,
    image: new URL((await getImage({ src: m.img, width: 600, format: 'jpg' })).src, Astro.site).href,
  })),
);
const services = (await getServices(locale)).map((s) => ({ name: s.data.menuTitle ?? s.data.title, url: s.url }));
const breadcrumb = schema.find((node) => node['@type'] === 'BreadcrumbList')?.['@id'] as string | undefined;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    dentistSchema({
      imageUrl: new URL(practicePhoto.src, Astro.site).href,
      locale,
      description: t.meta.homeDescription,
      catalogName: t.nav.services,
      services,
      staff,
    }),
    ...staff.map(personSchema),
    websiteSchema(),
    ...(noindex
      ? []
      : [webPageSchema({ url: canonical, name: title, description, locale, type: pageType, imageUrl: ogUrl, breadcrumbId: breadcrumb })]),
    ...schema,
  ],
};
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
{
  !noindex &&
    alternateLinks.map(([l, path]) => <link rel="alternate" hreflang={localeMeta[l].hreflang} href={new URL(path, Astro.site).href} />)
}
{!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{alternateLinks.filter(([l]) => l !== locale).map(([l]) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={title} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />
      {article.section && <meta property="article:section" content={article.section} />}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />

<meta name="geo.region" content="RS-04" />
<meta name="geo.placename" content={`${site.city}, Serbia`} />
<meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
<meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
<meta name="theme-color" content="#2b6073" />
{site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
