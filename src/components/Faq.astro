---
import Icon from './Icon.astro';
import { localeFromUrl } from '../i18n/locales';
import { useT } from '../i18n/ui';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const t = useT(localeFromUrl(Astro.url));
const { items, title = t.service.faqTitle } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl">{title}</h2>
      <div class="mt-6 flex flex-col gap-4">
        {items.map((f) => (
          <details class="group rounded-2xl border border-card bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 p-6 [&::-webkit-details-marker]:hidden">
              <h3 class="text-lg">{f.q}</h3>
              <Icon name="chevron-down" class="h-6 w-6 shrink-0 text-brand-700 transition group-open:rotate-180" />
            </summary>
            <p class="border-t border-card p-6 leading-[1.75]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
