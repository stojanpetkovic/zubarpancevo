---
/*
 * Sidebar beside service and post content: "on this page" links built from
 * the H2s, a booking card, and the other services. On large screens the
 * contents and booking card stay in view while the article scrolls.
 */
import { getServices } from '../i18n/content';
import { localeFromUrl } from '../i18n/locales';
import { useT } from '../i18n/ui';
import { site, telHref, bookingHref } from '../config/site';
import Icon from './Icon.astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  /** Current service key, left out of the services list. */
  exclude?: string;
}
const { headings, exclude } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const locale = localeFromUrl(Astro.url);
const t = useT(locale);
const services = (await getServices(locale)).filter((s) => s.key !== exclude);
---

<aside class="flex flex-col gap-6">
  <div class="card hidden p-6! lg:block">
    <p class="text-xs font-bold tracking-[0.1em] text-brand-700 uppercase">{t.aside.otherServices}</p>
    <ul class="mt-4 space-y-1">
      {
        services.map((s) => (
          <li>
            <a href={s.url} class="flex items-center gap-3 rounded-xl px-2 py-2 text-[15px] font-medium text-title hover:bg-tint-2 hover:text-brand-700">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-tint-2">
                <ServiceIcon name={s.data.icon} class="h-6 w-6" />
              </span>
              {s.data.menuTitle ?? s.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Contents and booking follow the reader down the page. -->
  <div class="flex flex-col gap-6 lg:sticky lg:top-32">
    {
      toc.length > 1 && (
        <nav class="card hidden p-6! lg:block" aria-label={t.aside.onThisPage}>
          <p class="text-xs font-bold tracking-[0.1em] text-brand-700 uppercase">{t.aside.onThisPage}</p>
          <ol class="mt-4 space-y-1 border-l-2 border-card">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="-ml-0.5 block border-l-2 border-transparent py-1.5 pl-4 text-[15px] leading-snug hover:border-brand-700 hover:text-brand-700">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="relative isolate overflow-clip rounded-[var(--radius-card)] bg-brand-900 p-7 text-white">
      <div class="absolute -top-20 -right-20 -z-10 h-56 w-56 rounded-full bg-brand-500/40 blur-[80px]" aria-hidden="true"></div>
      <p class="font-display text-xl font-semibold text-white">{t.common.book}</p>
      <p class="mt-2 text-sm leading-relaxed text-white/80">{t.aside.bookText}</p>
      <a href={bookingHref(locale, exclude)} class="btn-light mt-5 w-full"><Icon name="calendar" class="h-5 w-5" /> {t.common.bookOnline}</a>
      <a href={telHref} class="mt-3 flex items-center justify-center gap-2 rounded-full py-2 font-semibold text-white hover:bg-white/10">
        <Icon name="phone" class="h-5 w-5" /> {site.phone}
      </a>
    </div>
  </div>
</aside>
