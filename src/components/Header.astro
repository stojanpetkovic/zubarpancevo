---
import { Image } from 'astro:assets';
import { site, telHref, bookingHref } from '../config/site';
import { getServices } from '../i18n/content';
import { locales, localeFromUrl, localeMeta, pagePath, type Alternates } from '../i18n/locales';
import { useT } from '../i18n/ui';
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import ServiceIcon from './ServiceIcon.astro';
import SocialIcon from './SocialIcon.astro';
import logo from '../assets/logo-eric-dental-centar-transparent.png';

interface Props {
  /** This page in each language, for the language switcher. */
  alternates?: Alternates;
}
const { alternates = {} } = Astro.props;
const locale = localeFromUrl(Astro.url);
const t = useT(locale);

const services = await getServices(locale);
const implants = services.find((s) => s.key === 'zubni-implanti')!;
const path = Astro.url.pathname;
const home = pagePath(locale, 'home');
const isActive = (href: string) => (href === home ? path === home : path.startsWith(href));
// Dental implants has its own menu item, so it does not also light up "Services".
const servicesActive =
  path.startsWith(pagePath(locale, 'services')) || services.some((s) => s.key !== 'zubni-implanti' && path === s.url);

const links = [
  { href: pagePath(locale, 'about'), label: t.nav.about },
  { href: implants.url, label: t.nav.implants },
  { href: pagePath(locale, 'blog'), label: t.nav.blog },
  { href: pagePath(locale, 'contact'), label: t.nav.contact },
];

// Language switcher: the same page in the other language, or that language's home page.
const languages = locales.map((l) => ({
  locale: l,
  href: alternates[l] ?? pagePath(l, 'home'),
  label: localeMeta[l].label,
  short: localeMeta[l].short,
  current: l === locale,
}));

// Desktop menu link: semibold, with a brand bar under the current page.
const navLink = (active: boolean) => [
  'relative flex h-full items-center gap-1 px-1 text-[15px] font-semibold transition-colors after:absolute after:inset-x-1 after:bottom-0 after:h-[3px] after:rounded-t-full after:bg-brand-700 after:transition-transform hover:text-brand-700',
  active ? 'text-brand-700 after:scale-x-100' : 'text-title after:scale-x-0 hover:after:scale-x-100',
];
const shell = 'mx-auto w-full max-w-[88rem] px-4 sm:px-6 lg:px-10 xl:px-14';
const socialNames: Record<string, string> = { facebook: 'Facebook', instagram: 'Instagram', tiktok: 'TikTok', linkedin: 'LinkedIn' };
// Only networks with a link in config/site.ts are shown.
const socials = Object.entries(site.social)
  .filter(([, url]) => url)
  .map(([key, url]) => ({ key, url, label: socialNames[key] ?? key }));
const weekdays = site.hours[0];
const saturday = site.hours[1];
const phone = locale === 'sr' ? site.phone : site.phoneDisplayIntl;
---

<!-- Utility bar: address, hours, rating, languages; scrolls away, only the main bar stays. -->
<div class="hidden bg-brand-900 text-sm text-white/85 md:block">
  <div class:list={[shell, 'flex h-10 items-center justify-between gap-6']}>
    <div class="flex items-center gap-6">
      <a href={site.mapsUrl} class="flex items-center gap-2 hover:text-white" rel="noopener" target="_blank">
        <Icon name="map-pin" class="h-4 w-4 text-brand-200" />{site.street}, {site.city}
      </a>
      <span class="hidden items-center gap-2 lg:flex">
        <Icon name="clock" class="h-4 w-4 text-brand-200" />
        {t.common.weekdaysShort} {weekdays.opens}–{weekdays.closes} · {t.common.saturdayShort} {saturday.opens}–{saturday.closes}
      </span>
    </div>
    <div class="flex items-center gap-5">
      <a href={site.rating.url} class="flex items-center gap-2 hover:text-white" rel="noopener" target="_blank">
        <Stars class="h-3.5 w-3.5" />
        <span><strong class="text-white">{site.rating.value}</strong> · {t.common.ratings(site.rating.count)}</span>
      </a>
      {
        socials.length > 0 && (
          <ul class="flex items-center gap-1 border-l border-white/15 pl-4" aria-label={t.common.social}>
            {socials.map((sn) => (
              <li>
                <a
                  href={sn.url}
                  rel="noopener"
                  target="_blank"
                  aria-label={t.common.socialLabel(site.name, sn.label)}
                  class="inline-flex h-7 w-7 items-center justify-center rounded-full text-white/75 transition hover:bg-white/10 hover:text-white"
                >
                  <SocialIcon name={sn.key} class="h-3.5 w-3.5" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <!-- Languages -->
      <ul class="flex items-center gap-0.5 border-l border-white/15 pl-4" aria-label={t.nav.language}>
        {
          languages.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={localeMeta[l.locale].hreflang}
                lang={localeMeta[l.locale].htmlLang}
                aria-current={l.current ? 'true' : undefined}
                title={l.label}
                class:list={[
                  'inline-flex h-7 items-center rounded-full px-2.5 text-xs font-bold tracking-wide transition',
                  l.current ? 'bg-white text-brand-900' : 'text-white/75 hover:bg-white/10 hover:text-white',
                ]}
              >
                {l.short}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<header class="site-header sticky top-0 z-40 border-b border-transparent bg-white/95 backdrop-blur">
  <div class:list={[shell, 'flex h-20 items-center gap-3 lg:h-24 lg:gap-8']}>
    <a href={home} class="shrink-0" aria-label={`${site.name}, ${t.nav.homeAria}`}>
      <Image src={logo} alt={site.name} width={240} class="h-14 w-auto lg:h-[4.25rem]" loading="eager" />
    </a>

    <!-- Desktop -->
    <nav class="mx-auto hidden h-full items-stretch gap-7 lg:flex xl:gap-9" aria-label={t.nav.mainMenu}>
      <div class="group relative flex">
        <a href={pagePath(locale, 'services')} class:list={navLink(servicesActive)}>
          {t.nav.services} <Icon name="chevron-down" class="h-4 w-4 transition group-hover:rotate-180" />
        </a>
        <div
          class="invisible absolute top-full left-1/2 w-[34rem] -translate-x-1/2 translate-y-2 rounded-2xl border border-card bg-white p-3 opacity-0 shadow-[0_20px_50px_rgb(0_0_0/0.14)] transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
        >
          <div class="grid grid-cols-2 gap-1">
            {
              services.map((s) => (
                <a href={s.url} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] font-medium text-title hover:bg-tint-2 hover:text-brand-700">
                  <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tint-2">
                    <ServiceIcon name={s.data.icon} class="h-7 w-7" />
                  </span>
                  {s.data.menuTitle ?? s.data.title}
                </a>
              ))
            }
          </div>
          <a href={pagePath(locale, 'services')} class="mt-2 flex items-center justify-between rounded-xl bg-tint-2 px-4 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-100">
            {t.nav.allServices} <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
      {
        links.map((l) => (
          <a href={l.href} class:list={navLink(isActive(l.href))} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto hidden items-center gap-6 lg:ml-0 lg:flex">
      <a href={telHref} class="group hidden items-center gap-3 xl:flex">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-100 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
          <Icon name="phone" class="h-5 w-5" />
        </span>
        <span class="leading-tight">
          <span class="block text-xs font-semibold text-muted">{t.common.callUs}</span>
          <span class="block text-lg font-bold whitespace-nowrap text-title group-hover:text-brand-700">{phone}</span>
        </span>
      </a>
      <a href={bookingHref(locale)} class="btn-primary h-12 px-7! shadow-[0_8px_20px_rgb(43_96_115/0.3)]">
        <Icon name="calendar" class="h-5 w-5" /> {t.common.book}
      </a>
    </div>

    <!-- Mobile -->
    <a href={telHref} class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-100 text-brand-700 lg:hidden" aria-label={`${t.common.call} ${phone}`}>
      <Icon name="phone" class="h-5 w-5" />
    </a>
    <details class="group lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-card text-title [&::-webkit-details-marker]:hidden" aria-label={t.nav.menu}>
        <Icon name="menu" class="h-6 w-6 group-open:hidden" />
        <Icon name="x" class="hidden h-6 w-6 group-open:block" />
      </summary>
      <nav class="absolute inset-x-0 top-full h-[calc(100dvh-5rem)] overflow-y-auto border-t border-card bg-tint-1 px-4 pt-4 pb-28" aria-label={t.nav.mainMenu}>
        <div class="mx-auto max-w-md">
          <!-- Languages -->
          <ul class="mb-4 grid grid-cols-3 gap-2" aria-label={t.nav.language}>
            {
              languages.map((l) => (
                <li>
                  <a
                    href={l.href}
                    hreflang={localeMeta[l.locale].hreflang}
                    lang={localeMeta[l.locale].htmlLang}
                    aria-current={l.current ? 'true' : undefined}
                    class:list={[
                      'flex h-11 items-center justify-center rounded-xl text-sm font-semibold ring-1',
                      l.current ? 'bg-brand-700 text-white ring-brand-700' : 'bg-white text-title ring-card',
                    ]}
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href={home} class="block py-3 font-display text-xl font-semibold text-title">{t.nav.home}</a>
          <a href={pagePath(locale, 'services')} class="block py-3 font-display text-xl font-semibold text-title">{t.nav.services}</a>
          <div class="card mb-2 grid gap-1 p-3!">
            {
              services.map((s) => (
                <a href={s.url} class="flex items-center gap-3 rounded-xl px-2 py-2 text-title">
                  <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-tint-2">
                    <ServiceIcon name={s.data.icon} class="h-6.5 w-6.5" />
                  </span>
                  {s.data.menuTitle ?? s.data.title}
                </a>
              ))
            }
          </div>
          {links.map((l) => <a href={l.href} class="block py-3 font-display text-xl font-semibold text-title">{l.label}</a>)}
          <a href={bookingHref(locale)} class="btn-primary mt-6 w-full">{t.common.book}</a>
          <a href={telHref} class="btn-outline mt-3 w-full">{t.common.call} {phone}</a>
          <p class="mt-6 flex items-center justify-center gap-2 text-sm">
            <Stars class="h-4 w-4" /> <strong class="text-title">{site.rating.value}</strong> · {t.common.ratings(site.rating.count)}
          </p>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Shadow appears once the page scrolls; no JavaScript involved. */
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-shadow linear both;
      animation-timeline: scroll(root);
      animation-range: 0 80px;
    }
  }
  @keyframes header-shadow {
    from {
      box-shadow: 0 0 0 0 rgb(0 0 0 / 0);
      border-color: transparent;
    }
    to {
      box-shadow: 0 6px 24px rgb(0 0 0 / 0.08);
      border-color: var(--color-card);
    }
  }
  @supports not (animation-timeline: scroll()) {
    .site-header {
      border-color: var(--color-card);
    }
  }
</style>
