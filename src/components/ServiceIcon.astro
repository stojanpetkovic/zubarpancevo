---
/*
 * Duotone service illustrations drawn for this site (48px grid): a light
 * brand fill, a darker brand outline and a mid-teal accent. Original work,
 * so there is no third-party licence to track. Colours come from the theme
 * tokens, so they follow any palette change.
 */
const ink = 'var(--color-brand-800)';
const fill = 'var(--color-brand-100)';
const deep = 'var(--color-brand-200)';
const accent = 'var(--color-brand-500)';

// Molar outline shared by several icons.
const tooth =
  'M24 9c-2.6-2.2-6-3.4-9.2-2.6C10.2 7.6 7.4 12 8.3 17.4c.7 4.2 2.6 6.6 3.5 10.3 1.1 4.6 1.5 10.6 4.6 11.6 3.6 1.1 3.9-7.3 7.6-7.3s4 8.4 7.6 7.3c3.1-1 3.5-7 4.6-11.6.9-3.7 2.8-6.1 3.5-10.3.9-5.4-1.9-9.8-6.5-11C30 5.6 26.6 6.8 24 9Z';
// Four-point sparkle: curves pulled in to the centre between the tips.
const sparkle = (x: number, y: number, r: number) =>
  `M${x} ${y - r}Q${x} ${y} ${x + r} ${y}Q${x} ${y} ${x} ${y + r}Q${x} ${y} ${x - r} ${y}Q${x} ${y} ${x} ${y - r}Z`;

const icons: Record<string, string> = {
  implant: `
    <path d="M14 6h20a4 4 0 0 1 4 4v2a7 7 0 0 1-7 7H17a7 7 0 0 1-7-7v-2a4 4 0 0 1 4-4Z" fill="${fill}" stroke="${ink}"/>
    <path d="M15.5 10.5c1.2-1.3 2.8-2 4.5-2" stroke="#fff" stroke-width="2.2"/>
    <rect x="20" y="19" width="8" height="4.5" rx="1" fill="${deep}" stroke="${ink}"/>
    <path d="M18 23.5h12l-1.6 14.2L24 42.5l-4.4-4.8Z" fill="${deep}" stroke="${ink}"/>
    <path d="M18.6 28h10.8M19.1 32.3h9.8M19.6 36.5h8.8" stroke="${accent}"/>`,
  'tooth-canal': `
    <path d="${tooth}" fill="${fill}" stroke="${ink}"/>
    <path d="M19 17.5c1.6-2.2 8.4-2.2 10 0" stroke="${accent}" stroke-width="2.4"/>
    <path d="M19.4 18c-.6 5 .2 10.8 1 16.5M28.6 18c.6 5-.2 10.8-1 16.5" stroke="${accent}" stroke-width="2.4"/>
    <path d="M14.5 12.5c1-1.4 2.6-2.2 4.4-2.4" stroke="#fff" stroke-width="2.2"/>`,
  bridge: `
    <path d="M10 30.5l1.6 9.2c.4 2.3 3 2.3 3.4 0l1.6-9.2M31.4 30.5l1.6 9.2c.4 2.3 3 2.3 3.4 0l1.6-9.2" fill="${deep}" stroke="${ink}"/>
    <path d="M5 17c0-3.3 2.4-5.5 5.5-5.5 2.3 0 3.6 1.4 6 1.4s3.4-1.4 7.5-1.4 5.1 1.4 7.5 1.4 3.7-1.4 6-1.4c3.1 0 5.5 2.2 5.5 5.5v7c0 3.6-2.4 6.5-6 6.5H11c-3.6 0-6-2.9-6-6.5Z" fill="${fill}" stroke="${ink}"/>
    <path d="M17 13.4v16.6M31 13.4v16.6" stroke="${accent}"/>
    <path d="M8.8 16.5c.6-1.2 1.6-1.9 2.9-2.1" stroke="#fff" stroke-width="2.2"/>`,
  gums: `
    <path d="${tooth}" fill="${fill}" stroke="${ink}"/>
    <path d="M4.5 27.5c3.3-2.6 6.6-2.6 9.8 0s6.5 2.6 9.7 0 6.5-2.6 9.7 0 6.5 2.6 9.8 0V39a4 4 0 0 1-4 4h-31a4 4 0 0 1-4-4Z" fill="${deep}" stroke="${ink}"/>
    <path d="M24 33v5M21.5 35.5h5" stroke="${accent}" stroke-width="2.4"/>
    <path d="M14.5 12.5c1-1.4 2.6-2.2 4.4-2.4" stroke="#fff" stroke-width="2.2"/>`,
  'child-tooth': `
    <path d="${tooth}" fill="${fill}" stroke="${ink}"/>
    <circle cx="19" cy="18.5" r="1.7" fill="${ink}" stroke="none"/>
    <circle cx="29" cy="18.5" r="1.7" fill="${ink}" stroke="none"/>
    <circle cx="15.8" cy="22.6" r="1.8" fill="${deep}" stroke="none"/>
    <circle cx="32.2" cy="22.6" r="1.8" fill="${deep}" stroke="none"/>
    <path d="M19.8 23.2c1.1 1.5 2.5 2.2 4.2 2.2s3.1-.7 4.2-2.2" stroke="${ink}"/>
    <path d="${sparkle(40, 6, 3.5)}" fill="${accent}" stroke="none"/>`,
  surgery: `
    <g transform="translate(-3.5 1.5) scale(.86)"><path d="${tooth}" fill="${fill}" stroke="${ink}" stroke-width="2.3"/></g>
    <path d="M14 12c.9-1.2 2.3-1.9 3.8-2.1" stroke="#fff" stroke-width="2.2"/>
    <path d="M37.5 24.5s-6 6.6-6 10.6a6 6 0 0 0 12 0c0-4-6-10.6-6-10.6Z" fill="${accent}" stroke="${ink}"/>
    <path d="M35 35.5a2.7 2.7 0 0 0 2.6 2.4" stroke="#fff" stroke-width="2"/>`,
  braces: `
    <path d="M7 12.5c0-3.2 2.3-5.5 5.5-5.5h4c3.2 0 5.5 2.3 5.5 5.5V26c0 6.3-2.4 15-7.5 15S7 32.3 7 26Z" fill="${fill}" stroke="${ink}"/>
    <path d="M26 12.5c0-3.2 2.3-5.5 5.5-5.5h4c3.2 0 5.5 2.3 5.5 5.5V26c0 6.3-2.4 15-7.5 15S26 32.3 26 26Z" fill="${fill}" stroke="${ink}"/>
    <path d="M3 20.5h42" stroke="${ink}"/>
    <rect x="11" y="17" width="7" height="7" rx="1.5" fill="${accent}" stroke="${ink}"/>
    <rect x="30" y="17" width="7" height="7" rx="1.5" fill="${accent}" stroke="${ink}"/>
    <path d="M10.5 11.5c.6-1.3 1.7-2 3-2.1M29.5 11.5c.6-1.3 1.7-2 3-2.1" stroke="#fff" stroke-width="2.2"/>`,
  'sparkle-tooth': `
    <path d="${tooth}" fill="#fff" stroke="${ink}"/>
    <path d="M14.5 12.5c1-1.4 2.6-2.2 4.4-2.4" stroke="${deep}" stroke-width="2.4"/>
    <path d="${sparkle(39, 8, 5)}" fill="${accent}" stroke="none"/>
    <path d="${sparkle(8.5, 33, 3.5)}" fill="${accent}" stroke="none"/>
    <path d="${sparkle(41, 21, 2.5)}" fill="${deep}" stroke="none"/>`,
  syringe: `
    <path d="M27.5 10.5l10 10L22 36c-1.3 1.3-3.4 1.3-4.6 0l-5.4-5.4c-1.3-1.3-1.3-3.4 0-4.6Z" fill="${fill}" stroke="${ink}"/>
    <path d="M30.9 23.6L22 32.5c-1.3 1.3-3.4 1.3-4.6 0l-1.9-1.9 8.9-8.9Z" fill="${deep}" stroke="none"/>
    <path d="M32.5 5.5l10 10M37.5 10.5l-4.5 4.5M14.7 33.3L6 42" stroke="${ink}"/>
    <path d="M24 16l2.5 2.5M20.5 19.5L23 22M17 23l2.5 2.5" stroke="${accent}"/>
    <path d="${sparkle(40, 32, 4)}" fill="${accent}" stroke="none"/>`,
};

interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-12 w-12' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  fill="none"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name] ?? icons['sparkle-tooth']}
/>
