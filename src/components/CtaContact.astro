---
/*
 * Closing call to action on every page except /kontakt/. It sends visitors to
 * the booking form on the contact page (with the service preselected when
 * there is one) or to the phone, and carries the trust signals that make the
 * click worth it.
 */
import { Image } from 'astro:assets';
import { site, telHref, bookingHref } from '../config/site';
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import doctor from '../assets/tim/dr-milos-eric-ordinacija.webp';
import { localeFromUrl } from '../i18n/locales';
import { useT } from '../i18n/ui';

interface Props {
  /** Service key to preselect on the contact form. */
  service?: string;
  title?: string;
  text?: string;
}
const locale = localeFromUrl(Astro.url);
const t = useT(locale);
const { service, title = t.cta.title, text = t.cta.text } = Astro.props;
const phone = locale === 'sr' ? site.phone : site.phoneDisplayIntl;
---

<section class="relative isolate overflow-clip bg-linear-to-br from-brand-50 via-brand-100 to-brand-200/70 py-16 md:py-24">
  <!-- Own background, so the block reads as its own band whatever sits above or below it. -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(rgb(43_96_115/0.12)_1px,transparent_1px)] [background-size:20px_20px]" aria-hidden="true"></div>
  <div class="absolute -right-32 -bottom-40 -z-10 h-96 w-96 rounded-full bg-white/60 blur-[100px]" aria-hidden="true"></div>
  <div class="container-site">
    <div class="relative isolate grid overflow-clip rounded-[2rem] bg-brand-900 text-white shadow-[0_30px_80px_rgb(24_56_67/0.25)] lg:grid-cols-[1.15fr_0.85fr]">
      <div class="absolute -top-40 -left-40 -z-10 h-[28rem] w-[28rem] rounded-full bg-brand-500/30 blur-[120px]" aria-hidden="true"></div>
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(rgb(255_255_255/0.06)_1px,transparent_1px)] [background-size:22px_22px]" aria-hidden="true"></div>

      <!-- Copy -->
      <div class="flex flex-col gap-7 p-8 sm:p-12 lg:p-14">
        <p class="text-sm font-bold tracking-[0.1em] text-brand-200 uppercase">{t.cta.eyebrow}</p>
        <h2 class="text-[clamp(1.8rem,1.2rem+2.4vw,2.75rem)] leading-tight text-white">{title}</h2>
        <p class="max-w-xl text-lg leading-[1.65] text-white/80">{text}</p>

        <ul class="grid gap-3 text-sm font-semibold text-white sm:grid-cols-2">
          {
            t.cta.checks.map((check) => (
              <li class="flex items-center gap-2.5">
                <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/15">
                  <Icon name="check" class="h-3.5 w-3.5" />
                </span>
                {check}
              </li>
            ))
          }
        </ul>

        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={bookingHref(locale, service)} class="btn-light h-14 px-9! text-lg shadow-[0_12px_28px_rgb(0_0_0/0.25)]">
            <Icon name="calendar" class="h-5 w-5" /> {t.common.book}
          </a>
          <a href={telHref} class="btn h-14 border-2 border-white/40 px-8 text-lg text-white hover:border-white hover:bg-white/10">
            <Icon name="phone" class="h-5 w-5" /> {phone}
          </a>
        </div>

        <a href={site.rating.url} rel="noopener" target="_blank" class="flex w-fit items-center gap-3 text-sm text-white/80 hover:text-white">
          <Stars class="h-4 w-4" />
          <span>{t.common.ratingLine(site.rating.value, site.rating.count, site.rating.source)}</span>
        </a>
      </div>

      <!-- Photo -->
      <div class="relative min-h-[18rem] lg:min-h-full">
        <Image
          src={doctor}
          alt={t.cta.doctorAlt}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 460px, 100vw"
          class="absolute inset-0 h-full w-full object-cover object-[40%_30%]"
        />
        <div class="absolute inset-0 bg-linear-to-t from-brand-900/70 via-transparent to-transparent lg:bg-linear-to-r lg:from-brand-900 lg:via-brand-900/10 lg:to-transparent" aria-hidden="true"></div>
        <div class="absolute bottom-5 left-5 flex items-center gap-3 rounded-2xl bg-white/95 px-4 py-3 text-title shadow-[0_12px_32px_rgb(0_0_0/0.25)] backdrop-blur lg:right-6 lg:left-auto">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-700"><Icon name="award" class="h-5 w-5" /></span>
          <span>
            <span class="block font-semibold">{t.common.doctorName}</span>
            <span class="block text-xs font-semibold text-brand-700">{t.common.owner}</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
