---
/*
 * Hero for inner pages (services, posts, about, contact, hubs). Breadcrumbs,
 * an eyebrow, the H1 with a highlighted phrase, the lead, a slot for actions
 * or meta, an optional trust row, and the page image in a card with the
 * practice rating floating over it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Crumb } from '../lib/schema';
import { site } from '../config/site';
import Icon from './Icon.astro';
import ServiceIcon from './ServiceIcon.astro';
import Stars from './Stars.astro';
import { localeFromUrl } from '../i18n/locales';
import { useT } from '../i18n/ui';

interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  /** Part of the title shown in brand colour. */
  highlight?: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Service illustration shown beside the eyebrow. */
  icon?: string;
  /** Show the trust row (rating, since 2020, Saturdays). */
  trust?: boolean;
}
const { crumbs, eyebrow, title, highlight, lead, image, imageAlt = '', icon, trust = false } = Astro.props;
const t = useT(localeFromUrl(Astro.url));

const at = highlight ? title.indexOf(highlight) : -1;
const parts = at >= 0 ? [title.slice(0, at), highlight!, title.slice(at + highlight!.length)] : [title, '', ''];
---

<section class="relative overflow-clip bg-tint-1">
  <div class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-100/70 blur-[100px]" aria-hidden="true"></div>
  <div class:list={['container-site relative grid items-center gap-10 py-10 md:py-14 lg:gap-16 lg:py-16', image && 'lg:grid-cols-[1.05fr_0.95fr]']}>
    <div>
      <nav aria-label={t.nav.breadcrumbs} class="text-sm font-medium">
        <ol class="flex flex-wrap items-center gap-1.5">
          {
            crumbs.map((c, i) => (
              <li class="flex items-center gap-1.5">
                {i > 0 && <Icon name="chevron-down" class="h-3.5 w-3.5 -rotate-90 text-brand-500" />}
                {i < crumbs.length - 1 ? (
                  <a href={c.path} class="hover:text-brand-700 hover:underline">{c.name}</a>
                ) : (
                  <span aria-current="page" class="text-title">{c.name}</span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      {
        (eyebrow || icon) && (
          <div class="mt-8 flex items-center gap-3">
            {icon && (
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white shadow-sm ring-1 ring-card">
                <ServiceIcon name={icon} class="h-8 w-8" />
              </span>
            )}
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          </div>
        )
      }
      <h1 class="mt-5 text-[clamp(2.1rem,1.2rem+3.4vw,3.5rem)] leading-[1.12] text-title">
        {parts[0]}<span class="text-brand-700">{parts[1]}</span>{parts[2]}
      </h1>
      {lead && <p class="mt-6 max-w-2xl text-[clamp(1.05rem,0.95rem+0.4vw,1.2rem)] leading-[1.67]">{lead}</p>}
      <slot />
      {
        trust && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-card pt-6 text-sm font-semibold text-title">
            <li class="flex items-center gap-2">
              <Stars class="h-4 w-4" /> {site.rating.value} · {t.common.ratings(site.rating.count)}
            </li>
            <li class="flex items-center gap-2"><Icon name="calendar" class="h-4 w-4 text-brand-700" /> {t.common.since2020}</li>
            <li class="flex items-center gap-2"><Icon name="clock" class="h-4 w-4 text-brand-700" /> {t.common.saturdays}</li>
          </ul>
        )
      }
    </div>

    {
      image && (
        <div class="relative">
          <div class="overflow-hidden rounded-[var(--radius-media)] shadow-[0_24px_60px_rgb(0_0_0/0.18)]">
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 1024px) 520px, 100vw"
              class="h-64 w-full object-cover sm:h-80 lg:h-[30rem]"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <a
            href={site.rating.url}
            rel="noopener"
            target="_blank"
            class="absolute -bottom-5 left-4 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-[0_16px_40px_rgb(0_0_0/0.14)] sm:left-6 lg:-left-6"
          >
            <span class="font-display text-2xl font-bold text-title">{site.rating.value}</span>
            <span>
              <Stars class="h-4 w-4" />
              <span class="block text-xs font-semibold">{t.common.patientRatings(site.rating.count)}</span>
            </span>
          </a>
        </div>
      )
    }
  </div>
</section>
