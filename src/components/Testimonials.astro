---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { site } from '../config/site';
import { localeFromUrl } from '../i18n/locales';
import { useT } from '../i18n/ui';

// Reviews published on the practice's previous site, quoted as written in
// Serbian; the English and German pages show translations, marked as such.
const t = useT(localeFromUrl(Astro.url));
const [featured, ...rest] = t.testimonials.reviews;
const initials = (name: string) => name.split(' ').map((p) => p[0]).join('');
const basedOn = t.testimonials.basedOn(site.rating.count, site.rating.source);

// An average of exactly 5 means every rating is a five; the bars follow from
// the published numbers rather than from any breakdown we were given.
const allFives = site.rating.value === '5,0';
const bars = [5, 4, 3, 2, 1].map((stars) => ({
  stars,
  count: allFives ? (stars === 5 ? site.rating.count : 0) : null,
}));
---

<section class="section-pad bg-tint-2">
  <div class="container-site">
    <div class="mb-12 max-w-2xl md:mb-14">
      <p class="eyebrow">{t.testimonials.eyebrow}</p>
      <h2 class="mt-4 text-[clamp(1.75rem,1.1rem+2.6vw,2.5rem)] leading-tight">
        {t.testimonials.titleA}<span class="text-brand-700">{t.testimonials.titleB}</span>
      </h2>
      <p class="mt-4 text-[clamp(1rem,0.9rem+0.4vw,1.125rem)] leading-[1.67]">
        {t.testimonials.lead}
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-8">
      <!-- Rating summary -->
      <div class="relative isolate flex flex-col overflow-clip rounded-[var(--radius-card)] bg-brand-900 p-8 text-white sm:p-10">
        <div class="absolute -top-24 -right-24 -z-10 h-64 w-64 rounded-full bg-brand-500/35 blur-[90px]" aria-hidden="true"></div>
        <p class="text-sm font-bold tracking-[0.1em] text-brand-200 uppercase">{t.testimonials.average}</p>
        <div class="mt-4 flex items-end gap-4">
          <span class="font-display text-[5.5rem] leading-[0.85] font-bold tracking-tight">{site.rating.value}</span>
          <span class="pb-2 text-white/70">{t.testimonials.outOf}</span>
        </div>
        <div class="mt-5"><Stars class="h-7 w-7" /></div>
        <p class="mt-3 text-white/85">
          {basedOn[0]}<strong class="text-white">{basedOn[1]}</strong>{basedOn[2]}
        </p>

        {
          allFives && (
            <ul class="mt-8 space-y-2.5 border-t border-white/15 pt-8" aria-label={t.testimonials.distribution}>
              {bars.map((b) => (
                <li class="flex items-center gap-3 text-sm">
                  <span class="w-10 shrink-0 text-white/80">{b.stars} ★</span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-white/15">
                    <span class="block h-full rounded-full bg-amber-400" style={`width:${b.count ? 100 : 0}%`} />
                  </span>
                  <span class="w-6 shrink-0 text-right text-white/80">{b.count}</span>
                </li>
              ))}
            </ul>
          )
        }

        <a
          href={site.rating.url}
          rel="noopener"
          target="_blank"
          class="btn mt-8 self-start border-2 border-white/40 text-white hover:border-white hover:bg-white/10 lg:mt-auto"
        >
          {t.testimonials.viewOn(site.rating.source)} <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <!-- Quotes -->
      <div class="flex flex-col gap-6">
        <figure class="card relative flex flex-1 flex-col gap-6 overflow-hidden p-8! sm:p-10!">
          <span class="icon-tile h-14! w-14! bg-brand-700! text-white!">
            <Icon name="quote" class="h-6 w-6" />
          </span>
          <blockquote class="relative text-[clamp(1.15rem,1rem+0.6vw,1.4rem)] leading-[1.6] font-medium text-title">
            „{featured.text}”
          </blockquote>
          <figcaption class="relative mt-auto flex items-center gap-4 border-t border-card pt-6">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-700 font-semibold text-white">
              {initials(featured.name)}
            </span>
            <span>
              <span class="block text-lg font-semibold text-title">{featured.name}</span>
              <span class="text-sm text-brand-700">{featured.note}</span>
              {t.testimonials.translatedNote && <span class="block text-xs text-muted">{t.testimonials.translatedNote}</span>}
            </span>
          </figcaption>
        </figure>

        {
          rest.map((r) => (
            <figure class="card flex flex-col gap-5 p-8! sm:flex-row sm:items-center sm:gap-8">
              <blockquote class="flex-1 text-lg leading-[1.65] text-title">„{r.text}”</blockquote>
              <figcaption class="flex shrink-0 items-center gap-3 sm:w-52 sm:border-l sm:border-card sm:pl-8">
                <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-100 font-semibold text-brand-800">
                  {initials(r.name)}
                </span>
                <span>
                  <span class="block font-semibold text-title">{r.name}</span>
                  <span class="text-sm text-brand-700">{r.note}</span>
                  {t.testimonials.translatedNote && <span class="block text-xs text-muted">{t.testimonials.translatedNote}</span>}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
